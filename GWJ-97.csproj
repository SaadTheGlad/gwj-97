<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>GWJ97</RootNamespace>
  </PropertyGroup>
    <!-- added by the 2dog tool: properties 2dog hosts need that were not already set -->
    <PropertyGroup>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <DefineConstants>$(DefineConstants);LIBGODOT_ENABLED</DefineConstants>
        <DefaultItemExcludes>$(DefaultItemExcludes);GWJ-97.2dog/**;GWJ-97.web/**;GWJ-97.tests3/**</DefaultItemExcludes>
    </PropertyGroup>
    <!-- added by the 2dog tool: compiles the web bootstrap (in the web host folder) into this game assembly -->
    <ItemGroup>
        <Compile Include="GWJ-97.web/TwoDogWebBoot.cs" Condition="Exists('$(MSBuildThisFileDirectory)GWJ-97.web/TwoDogWebBoot.cs')" />
    </ItemGroup>
</Project>